# ==============================================================================
# Meaw Genarator — Environment Variables Configuration / এনভায়রনমেন্ট কনফিগারেশন
# ==============================================================================
# Create a .env file in the project root with the following variables:
# ==============================================================================

# 1. Google Gemini API Key (আবশ্যক / REQUIRED)
# Secret Name: GEMINI_API_KEY
# Get your key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Gemini Primary & Fallback Models (মডেল সিলেকশন)
GEMINI_MODEL_PRIMARY=gemini-3.5-flash-lite
GEMINI_MODEL_FALLBACK=gemini-3.1-flash-lite

# 3. Server Port (ঐচ্ছিক / OPTIONAL)
PORT=3000
